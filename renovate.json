{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docker/images\\.env$/"],
      "matchStrings": [
        "IMAGE_[A-Z_]+=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/^@mikro-orm\\//", "!@mikro-orm/nestjs"],
      "groupName": "mikro-orm"
    },
    {
      "matchPackageNames": ["@mikro-orm/nestjs"],
      "groupName": "mikro-orm-nestjs"
    },
    {
      "matchPackageNames": ["/^@opentelemetry\\//"],
      "groupName": "opentelemetry"
    },
    {
      "groupName": "better-auth",
      "matchPackageNames": [
        "better-auth",
        "auth",
        "@better-auth/{/,}**",
        "!@better-auth/utils"
      ]
    },
    {
      "groupName": "better-auth peers",
      "matchPackageNames": ["better-call", "@better-auth/utils"],
      "enabled": false,
      "description": "Pinned by the peerDependencies of @better-auth/api-key; bumped by hand together with the better-auth group"
    },
    {
      "groupName": "bull-board",
      "matchPackageNames": ["@bull-board/{/,}**"]
    },
    {
      "groupName": "mailpit image",
      "matchPackageNames": ["axllent/mailpit"],
      "pinDigests": true
    },
    {
      "groupName": "casl",
      "matchPackageNames": ["@casl/{/,}**", "@ucast/{/,}**"],
      "description": "Major bumps must re-run test/unit/modules/tenancy/casl-contract.spec.ts (spike T1, spec SP3 §8.7)"
    },
    {
      "groupName": "openfeature",
      "matchPackageNames": ["@openfeature/{/,}**"],
      "description": "Bump server-sdk and its core peer together; re-run test/unit/core/flags/openfeature-contract.spec.ts (spike P3, spec SP6 §4)"
    },
    {
      "groupName": "standardwebhooks",
      "matchPackageNames": ["standardwebhooks"],
      "description": "Re-run test/unit/modules/integrations/standard-webhooks.contract.spec.ts (spike W1, spec SP6 §4)"
    }
  ]
}
