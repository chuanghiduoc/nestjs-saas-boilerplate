{
  "name": "backend-demo-scaffold",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "typecheck": "node node_modules/ts7/bin/tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start -b swc --watch --entryFile main.api",
    "start:debug": "nest start --debug --watch",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "migrate": "node dist/main.migrate.js",
    "lint": "oxlint --type-aware src/ test/ && prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "env:example": "node --import @swc-node/register/esm-register src/scripts/gen-env-example.ts",
    "openapi:export": "node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.1",
    "@mikro-orm/migrations": "7.2.1",
