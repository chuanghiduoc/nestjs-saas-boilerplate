    "@mikro-orm/postgresql": "7.2.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@scalar/nestjs-api-reference": "1.2.21",
    "bullmq": "6.3.8",
    "cron-parser": "5.10.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-cls": "7.0.0",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.1.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "8.23.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.0",
    "testcontainers": "12.1.0",
    "ts7": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "5.0.1"
  }
