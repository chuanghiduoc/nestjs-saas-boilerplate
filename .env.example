# App config (copy to .env). Reaches the app containers via compose env_file.
# Compose infra secrets live in .env.infra (see .env.infra.example), never here.

# [app] Process role, set by the entrypoint (required)
APP_ROLE=

# [app] Runtime environment
NODE_ENV=development

# [app] Service name used in logs and key namespaces
APP_SERVICE_NAME=nestjs-saas-boilerplate

# [app] Hard deadline after SIGTERM/SIGINT: if closing the app and flushing telemetry takes longer, log an error and exit 1. Must be >= OUTBOX_ENQUEUE_TIMEOUT_MS + QUEUE_SHUTDOWN_TIMEOUT_MS + QUEUE_SHUTDOWN_ABORT_GRACE_MS + APP_SHUTDOWN_RESERVE_MS (worker) and >= HEALTH_DRAIN_DELAY_MS + APP_SHUTDOWN_RESERVE_MS (api), and below the orchestrator kill deadline (Kubernetes terminationGracePeriodSeconds, default 30s, minus any preStop sleep)
APP_SHUTDOWN_TIMEOUT_MS=28000

# [app] Part of APP_SHUTDOWN_TIMEOUT_MS kept after the worst-case relay stop and queue drain (worker) or the health drain delay (api) for closing HTTP, DB, Redis and the final OTLP flush; must exceed OTEL_EXPORTER_OTLP_TIMEOUT
APP_SHUTDOWN_RESERVE_MS=6000

# [errors] Base URI for problem "type" (docs page per error code), no trailing slash
HTTP_PROBLEM_TYPE_BASE=/errors

# [logging] Minimum log level
LOG_LEVEL=info

# [logging] Extra pino redact paths, added to the built-in list
LOG_EXTRA_REDACT_PATHS=

# [database] Host for the app connection (PgBouncer in production) (required)
DB_HOST=

# [database] Port for the app connection
DB_PORT=5432

# [database] Database name (required)
DB_NAME=

# [database] Role for api/worker business queries (RLS enforced)
DB_APP_USER=app_user

# [database] Password of app role (required)
DB_APP_PASSWORD=

# [database] Host for the relay connection (defaults to DB_HOST); worker only (optional)
DB_RELAY_HOST=

# [database] Port for the relay connection (defaults to DB_PORT) (optional)
DB_RELAY_PORT=

# [database] Role for outbox relay, cleanup, reconcile, metrics (no BYPASSRLS)
DB_RELAY_USER=app_relay

# [database] Password of relay role (required for worker) (optional)
DB_RELAY_PASSWORD=

# [database] Role that owns tables and runs migrations
DB_OWNER_USER=app_owner

# [database] Password of owner role (required only for migrate) (optional)
DB_OWNER_PASSWORD=

# [database] Direct Postgres host for migrations, never PgBouncer (required only for migrate; no fallback to DB_HOST) (optional)
DB_MIGRATION_HOST=

# [database] Direct Postgres port for migrations (required only for migrate; no fallback to DB_PORT) (optional)
DB_MIGRATION_PORT=

# [database] Max app connections per process
DB_POOL_MAX=10

# [database] Max relay connections per worker
DB_RELAY_POOL_MAX=2

# [database] statement_timeout applied with SET LOCAL in worker transactions (role default applies elsewhere)
DB_WORKER_STATEMENT_TIMEOUT_MS=60000

# [database] lock_timeout during migrations
DB_MIGRATION_LOCK_TIMEOUT_MS=5000

# [database] statement_timeout during migrations
DB_MIGRATION_STATEMENT_TIMEOUT_MS=600000

# [database] Retries for serialization failures/deadlocks (outermost transaction only)
DB_TX_RETRY_ATTEMPTS=3

# [database] Base delay for transaction retry backoff (full jitter)
DB_TX_RETRY_BASE_MS=20

# [database] TLS to Postgres/PgBouncer: require encrypts without verifying the certificate; production requires verify-full
DB_SSL_MODE=disable

# [database] CA bundle path for verify-full (optional)
DB_SSL_CA_PATH=

# [database] Log SQL (development only)
DB_DEBUG=false

# [http] HTTP listen port. compose.yaml maps and health-checks the api container on 3000; change both if this changes
HTTP_PORT=3000

# [http] HTTP listen host
HTTP_HOST=0.0.0.0

# [http] Max request body size (larger → 413)
HTTP_BODY_LIMIT=1mb

# [http] Lingering close after a 413: how long, counted from the 413 decision, the server may keep the connection to read and discard the rest of the request body so the client can read the 413. When it elapses the socket is destroyed (after the 413 is flushed). Must stay below the Node HTTP server requestTimeout (rule http-body-limit-linger)
HTTP_BODY_LIMIT_LINGER_MS=5000

# [http] Lingering close after a 413: max bytes of the remaining request body (Content-Length or chunked) read and discarded, counted from the 413 decision. Past it the server stops reading (TCP backpressure holds the client), sends FIN once the 413 is flushed, and destroys the socket when HTTP_BODY_LIMIT_LINGER_MS elapses if the client has not closed
HTTP_BODY_LIMIT_LINGER_BYTES=4194304

# [http] Allowed CORS origins; empty = CORS disabled
HTTP_CORS_ORIGINS=

# [http] Express trust proxy: true|false|hop count|comma-separated addresses/CIDRs/presets
HTTP_TRUST_PROXY=false

# [http] Accepted request Content-Types (others → 415)
HTTP_ALLOWED_CONTENT_TYPES=application/json,application/merge-patch+json

# [http] Serve API reference UI
HTTP_DOCS_ENABLED=false

# [http] Path of API reference UI
HTTP_DOCS_PATH=/docs

# [http] Version-pinned https URL of the API reference script (required when docs are enabled) (optional)
HTTP_DOCS_CDN_URL=

# [pagination] Upper bound for pageSize/limit
PAGINATION_MAX_PAGE_SIZE=100

# [pagination] Default pageSize/limit
PAGINATION_DEFAULT_PAGE_SIZE=20

# [pagination] Max page*pageSize for offset pagination
PAGINATION_MAX_OFFSET_ROWS=10000

# [pagination] totalCount is exact up to this cap; above it totalCountExact=false
PAGINATION_TOTAL_COUNT_CAP=10000

# [throttle] Default requests per window per route per tracker (principal+org, else client IP)
THROTTLE_DEFAULT_LIMIT=300

# [throttle] Default rate limit window (ms, whole seconds)
THROTTLE_DEFAULT_TTL_MS=60000

# [throttle] Requests per window per client IP that may reach credential storage before authentication (API keys, S2-R51)
THROTTLE_PRE_AUTH_LIMIT=300

# [throttle] Pre-authentication rate limit window (ms, whole seconds)
THROTTLE_PRE_AUTH_TTL_MS=60000

# [idempotency] How long a completed response is stored and replayed; routes may set a shorter ttl
IDEMPOTENCY_TTL_SEC=86400

# [idempotency] How long an in-progress lock lives (a crashed request frees its key after this); must exceed the slowest idempotent handler, else a retry can run concurrently
IDEMPOTENCY_LOCK_TTL_SEC=120

# [idempotency] Minimum Idempotency-Key length
IDEMPOTENCY_KEY_MIN_LENGTH=16

# [idempotency] Maximum Idempotency-Key length
IDEMPOTENCY_KEY_MAX_LENGTH=255

# [idempotency] Headers stored and replayed with a response or error (allowlist; set-cookie is forbidden)
IDEMPOTENCY_REPLAY_HEADERS=location,etag,retry-after

# [redis] Redis URL (redis:// or rediss://, include ACL user and password) (required)
REDIS_URL=

# [redis] Service prefix for every Redis key; the environment name is appended
REDIS_KEY_PREFIX=app

# [redis] ioredis commandTimeout for non-blocking clients
REDIS_COMMAND_TIMEOUT_MS=1000

# [queue] Comma-separated queues this worker consumes; empty = all registered queues
WORKER_QUEUES=

# [queue] Default max attempts per job
QUEUE_DEFAULT_ATTEMPTS=5

# [queue] Base delay for exponential backoff
QUEUE_DEFAULT_BACKOFF_MS=2000

# [queue] Remove completed jobs older than this
QUEUE_KEEP_COMPLETED_AGE_SEC=3600

# [queue] Keep at most this many completed jobs per queue
QUEUE_KEEP_COMPLETED_COUNT=1000

# [queue] Remove failed jobs older than this
QUEUE_KEEP_FAILED_AGE_SEC=604800

# [queue] Keep at most this many failed jobs per queue (bounds Redis memory)
QUEUE_KEEP_FAILED_COUNT=10000

# [queue] Default concurrency for io queues
QUEUE_IO_CONCURRENCY=20

# [queue] Default concurrency for cpu queues
QUEUE_CPU_CONCURRENCY=1

# [queue] Max wait for in-flight jobs on shutdown. OUTBOX_ENQUEUE_TIMEOUT_MS + QUEUE_SHUTDOWN_TIMEOUT_MS + QUEUE_SHUTDOWN_ABORT_GRACE_MS + APP_SHUTDOWN_RESERVE_MS must fit in APP_SHUTDOWN_TIMEOUT_MS
QUEUE_SHUTDOWN_TIMEOUT_MS=13000

# [queue] After the shutdown timeout, jobs get an abort signal; max extra wait for them to stop (counts toward the same kill deadline)
QUEUE_SHUTDOWN_ABORT_GRACE_MS=4000

# [queue] Per-queue concurrency, e.g. "billing=1,notifications=50"
QUEUE_CONCURRENCY_OVERRIDES=

# [queue] How often workers check for stalled jobs
QUEUE_STALLED_INTERVAL_MS=30000

# [queue] Job lock duration; must exceed the longest event-loop stall
QUEUE_LOCK_DURATION_MS=30000

# [queueDashboard] Serve the read-only Bull Board on the worker (enable on exactly one deployment)
QUEUE_DASHBOARD_ENABLED=false

# [queueDashboard] Listen host of the dashboard (internal network only)
QUEUE_DASHBOARD_HOST=127.0.0.1

# [queueDashboard] Listen port of the dashboard. compose.yaml maps the worker on 3002; change both together
QUEUE_DASHBOARD_PORT=3002

# [queueDashboard] Mount path of the dashboard
QUEUE_DASHBOARD_BASE_PATH=/queues

# [queueDashboard] Client IPs/CIDRs allowed to reach the dashboard (required in production when enabled)
QUEUE_DASHBOARD_IP_ALLOWLIST=

# [outbox] Relay poll interval when the outbox is empty
OUTBOX_POLL_INTERVAL_MS=1000

# [outbox] Rows claimed per relay iteration
OUTBOX_BATCH_SIZE=100

# [outbox] Start relay loop on worker bootstrap
OUTBOX_AUTOSTART=true

# [outbox] Delete published outbox rows older than this. Invariant (checked at boot): OUTBOX_RETENTION_DAYS in seconds > QUEUE_KEEP_FAILED_AGE_SEC, so a failed dispatch/deliver job can still be retried manually and find its row. Unpublished and parked rows are never deleted
OUTBOX_RETENTION_DAYS=14

# [outbox] Delete inbox (processed_events) records older than this. Invariant (checked at boot): INBOX_RETENTION_DAYS > OUTBOX_RETENTION_DAYS + QUEUE_KEEP_FAILED_AGE_SEC, i.e. longer than any event can still be redelivered (re-dispatch while its outbox row exists, then a manual retry of the deliver job); deleting a record earlier lets a redelivery run the side effect twice
INBOX_RETENTION_DAYS=30

# [outbox] Log error when publish attempts exceed this
OUTBOX_ATTEMPTS_ALERT_THRESHOLD=10

# [outbox] Rows rejected this many times are parked (never claimed again) for dead-letter handling
OUTBOX_MAX_PUBLISH_ATTEMPTS=20

# [outbox] Cap of the exponential backoff between relay iterations after a batch-level (Redis/DB) failure
OUTBOX_ERROR_BACKOFF_MAX_MS=30000

# [outbox] How long a claimed outbox row stays reserved for the relay that claimed it. If that relay dies before marking the row published, another relay re-claims it after the lease expires and re-enqueues it with the same jobId (deduplicated). Invariant (checked at boot): OUTBOX_CLAIM_LEASE_MS >= 2 x OUTBOX_ENQUEUE_TIMEOUT_MS
OUTBOX_CLAIM_LEASE_MS=30000

# [outbox] Max time one relay batch waits for Redis to accept its jobs; on timeout the batch fails as a whole (no publish attempt counted) and backs off. The relay never holds a DB transaction while waiting, so this does not need to stay below idle_in_transaction_session_timeout. Worker shutdown waits up to this long for an in-flight batch, so it counts toward APP_SHUTDOWN_TIMEOUT_MS
OUTBOX_ENQUEUE_TIMEOUT_MS=5000

# [outbox] Cron for outbox/inbox cleanup
OUTBOX_CLEANUP_CRON=0 5 * * *

# [outbox] Timezone for cleanup cron
OUTBOX_CLEANUP_TZ=Asia/Ho_Chi_Minh

# [outbox] Rows deleted per cleanup statement (each statement is its own short transaction)
OUTBOX_CLEANUP_BATCH_SIZE=5000

# [outbox] Max cleanup statements per table per run; leftovers are deleted by the next run
OUTBOX_CLEANUP_MAX_BATCHES=100

# [scheduler] Cron for reconciling scheduled_tasks with the queue (also bounds how long a lost or drifted tenant schedule stays wrong)
SCHEDULER_RECONCILE_CRON=*/10 * * * *

# [scheduler] Timezone for the reconcile cron
SCHEDULER_RECONCILE_TZ=UTC

# [scheduler] Minimum interval between runs of a tenant-defined schedule (checked on the time-of-day grid, day boundary included)
SCHEDULER_TENANT_MIN_INTERVAL_SEC=300

# [resilience] Per-attempt timeout for outbound calls (aborts the request via its signal)
RESILIENCE_DEFAULT_TIMEOUT_MS=10000

# [resilience] Retries for idempotent outbound calls
RESILIENCE_DEFAULT_RETRIES=2

# [resilience] Base delay for exponential backoff with full jitter
RESILIENCE_DEFAULT_RETRY_BASE_MS=200

# [resilience] Consecutive failures that open the circuit
RESILIENCE_DEFAULT_BREAKER_THRESHOLD=5

# [resilience] Time before a half-open probe
RESILIENCE_DEFAULT_BREAKER_HALF_OPEN_MS=30000

# [resilience] Max concurrent calls per provider
RESILIENCE_DEFAULT_BULKHEAD_LIMIT=20

# [resilience] Max queued calls per provider
RESILIENCE_DEFAULT_BULKHEAD_QUEUE=100

# [resilience] Per-provider overrides as JSON {"<provider>":{"timeoutMs":..,"retries":..}}
RESILIENCE_OVERRIDES={}

# [resilience] URL schemes outbound HTTP may use (http,https); production allows https only
RESILIENCE_ALLOWED_SCHEMES=https

# [resilience] Destination ports outbound HTTP may use
RESILIENCE_ALLOWED_PORTS=80,443

# [resilience] CIDRs exempt from the private-address block; /0 and ranges covering cloud metadata are rejected (empty in production unless an internal provider is required)
RESILIENCE_SSRF_ALLOW_CIDRS=

# [resilience] Max outbound response body size (bytes, enforced while streaming)
RESILIENCE_MAX_RESPONSE_BYTES=10485760

# [resilience] Cap on an upstream Retry-After (seconds) passed to callers and to clients on 503
RESILIENCE_RETRY_AFTER_MAX_SEC=300

# [security] Field encryption keyring as JSON {"<kid>":"<base64 32-byte key>"}; keep retired kids for decryption (secret) (required)
FIELD_ENCRYPTION_KEYS=

# [security] Key id used for new encryptions (required)
FIELD_ENCRYPTION_ACTIVE_KID=

# [otel] Enable OpenTelemetry export
OTEL_ENABLED=false

# [otel] OTLP HTTP endpoint base URL (required when enabled) (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# [otel] service.name resource attribute
OTEL_SERVICE_NAME=nestjs-saas-boilerplate

# [otel] Head sampling ratio for new traces and for remote parents sent by clients
OTEL_TRACES_SAMPLE_RATIO=0.1

# [otel] Metric export interval; also how often queue/outbox gauges query Redis and the DB
OTEL_METRICS_INTERVAL_MS=15000

# [otel] Timeout of one OTLP export (traces and metrics), including the final flush on shutdown; must stay below APP_SHUTDOWN_RESERVE_MS
OTEL_EXPORTER_OTLP_TIMEOUT=3000

# [health] Timeout of each readiness check; a slower dependency counts as down. Must stay below the readiness probe timeoutSeconds (Kubernetes default 1s) so the probe gets a clean 503, not a timeout. Checks: api = DB only (Redis is shared and the api degrades without it, ruling R21); worker = DB + Redis
HEALTH_CHECK_TIMEOUT_MS=500

# [health] api only: after SIGTERM, readiness answers 503 for this long before the HTTP server closes, so the load balancer stops routing first. The worker never waits for it (no load balancer). HEALTH_DRAIN_DELAY_MS + APP_SHUTDOWN_RESERVE_MS must fit in APP_SHUTDOWN_TIMEOUT_MS
HEALTH_DRAIN_DELAY_MS=5000

# [health] Port of the worker health server (/health/live, /health/ready); 0 = any free port
WORKER_HEALTH_PORT=3001

# [health] Listen host of the worker health server
WORKER_HEALTH_HOST=0.0.0.0

# [notifications] Locale of transactional emails; the worker refuses to start unless every template has files for it
NOTIFICATIONS_DEFAULT_LOCALE=en

# [notifications] How long a worker owns a delivery it claimed (fencing lease); must exceed SMTP_SEND_DEADLINE_MS and be below the total job retry backoff
NOTIFICATIONS_CLAIM_LEASE_MS=20000

# [notifications] Minimum time between two re-enqueues of the same stuck delivery by the reconcile cron
NOTIFICATIONS_REENQUEUE_COOLDOWN_SEC=300

# [notifications] Claims after which the reconcile cron gives a stuck delivery up (FAILED + event)
NOTIFICATIONS_MAX_TOTAL_ATTEMPTS=10

# [notifications] Delete SENT/FAILED deliveries older than this
NOTIFICATIONS_RETENTION_DAYS=30

# [notifications] Cron of notifications.reconcile-deliveries
NOTIFICATIONS_RECONCILE_CRON=*/5 * * * *

# [notifications] Timezone of the reconcile cron
NOTIFICATIONS_RECONCILE_TZ=UTC

# [notifications] Stuck deliveries examined per reconcile run
NOTIFICATIONS_RECONCILE_BATCH_SIZE=200

# [notifications] Cron of notifications.purge-deliveries
NOTIFICATIONS_PURGE_CRON=30 4 * * *

# [notifications] Timezone of the purge cron
NOTIFICATIONS_PURGE_TZ=UTC

# [notifications] Rows deleted per purge statement
NOTIFICATIONS_PURGE_BATCH_SIZE=5000

# [notifications] Max purge statements per run
NOTIFICATIONS_PURGE_MAX_BATCHES=100

# [smtp] SMTP host (required on the worker) (optional)
SMTP_HOST=

# [smtp] SMTP port
SMTP_PORT=587

# [smtp] Implicit TLS (port 465)
SMTP_SECURE=false

# [smtp] Require STARTTLS on a plain connection
SMTP_REQUIRE_TLS=true

# [smtp] SMTP username (empty = no AUTH) (optional)
SMTP_USER=

# [smtp] SMTP password (secret) (optional)
SMTP_PASSWORD=

# [smtp] Verify the SMTP server certificate
SMTP_TLS_REJECT_UNAUTHORIZED=true

# [smtp] Connect timeout
SMTP_CONNECTION_TIMEOUT_MS=5000

# [smtp] Timeout waiting for the SMTP greeting
SMTP_GREETING_TIMEOUT_MS=5000

# [smtp] Socket inactivity timeout
SMTP_SOCKET_TIMEOUT_MS=10000

# [smtp] Hard deadline for one send; on expiry the pooled connection is closed and the attempt counts as SMTP_TIMEOUT. Must be below NOTIFICATIONS_CLAIM_LEASE_MS and below the resilience timeout of the "smtp" provider
SMTP_SEND_DEADLINE_MS=8000

# [smtp] From header, e.g. "App <noreply@example.com>" (required on the worker) (optional)
MAIL_FROM=

# [identity] local | hybrid | external (spec SP2 §5.6)
AUTH_MODE=local

# [identity] Better Auth secret, >= 32 chars; required unless AUTH_MODE=external (secret) (optional)
BETTER_AUTH_SECRET=

# [identity] Public base URL of the API (links in emails, cookie scope); required unless external (optional)
AUTH_BASE_URL=

# [identity] Mount path of Better Auth routes
AUTH_BASE_PATH=/api/auth

# [identity] Secure cookies; false only in development/test on http://localhost or http://127.0.0.1
AUTH_SECURE_COOKIES=true

# [identity] Better Auth cookie prefix (^[a-z0-9-]{1,32}$); empty = APP_SERVICE_NAME (optional)
AUTH_COOKIE_PREFIX=

# [identity] Parent cookie domain to share cookies across subdomains; empty = host-only cookies (optional)
AUTH_COOKIE_DOMAIN=

# [identity] Explicit confirmation that no subdomain is controlled by third parties or user content; required with AUTH_COOKIE_DOMAIN
AUTH_COOKIE_DOMAIN_ALL_SUBDOMAINS_TRUSTED=false

# [identity] SameSite of Better Auth cookies (none requires secure cookies)
AUTH_COOKIE_SAMESITE=lax

# [identity] Session lifetime
AUTH_SESSION_EXPIRES_IN_SEC=604800

# [identity] Refresh the session expiry when older than this
AUTH_SESSION_UPDATE_AGE_SEC=86400

# [identity] Sensitive operations need a session created within this window
AUTH_SESSION_FRESH_AGE_SEC=600

# [identity] Minimum password length
AUTH_PASSWORD_MIN_LENGTH=12

# [identity] Maximum password length (rejected before hashing)
AUTH_PASSWORD_MAX_LENGTH=128

# [identity] Sign-in requires a verified email
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# [identity] Email verification link lifetime
AUTH_EMAIL_TOKEN_TTL_SEC=86400

# [identity] Password reset link lifetime
AUTH_RESET_TOKEN_TTL_SEC=3600

# [identity] Google OAuth client id (set together with the secret) (optional)
AUTH_GOOGLE_CLIENT_ID=

# [identity] Google OAuth client secret (secret) (optional)
AUTH_GOOGLE_CLIENT_SECRET=

# [identity] Provider ids allowed to link by verified email (spec §5.4)
AUTH_TRUSTED_PROVIDERS=

# [identity] Generic OIDC provider id (hybrid mode; not "google") (optional)
AUTH_OIDC_PROVIDER_ID=

# [identity] OIDC discovery URL (hybrid mode) (optional)
AUTH_OIDC_DISCOVERY_URL=

# [identity] OIDC client id (hybrid mode) (optional)
AUTH_OIDC_CLIENT_ID=

# [identity] OIDC client secret (hybrid mode, secret) (optional)
AUTH_OIDC_CLIENT_SECRET=

# [identity] OIDC scopes
AUTH_OIDC_SCOPES=openid,email,profile

# [identity] TOTP issuer label; empty = APP_SERVICE_NAME (optional)
AUTH_TWO_FACTOR_ISSUER=

# [identity] Header carrying API keys (lowercase token, must be redacted in logs)
AUTH_API_KEY_HEADER=x-api-key

# [identity] Default API key lifetime
AUTH_API_KEY_DEFAULT_EXPIRES_IN_SEC=7776000

# [identity] iss of JWTs issued to other services; empty = origin of AUTH_BASE_URL (optional)
AUTH_JWT_ISSUER=

# [identity] aud of JWTs issued to other services; empty = origin of AUTH_BASE_URL (optional)
AUTH_JWT_AUDIENCE=

# [identity] Lifetime of issued JWTs (they stay valid until exp after revocation; must stay short)
AUTH_JWT_EXPIRES_IN_SEC=900

# [identity] Rotate the JWT signing key after this long
AUTH_JWKS_ROTATION_INTERVAL_SEC=2592000

# [identity] Keep a rotated key in the JWKS for this long
AUTH_JWKS_GRACE_PERIOD_SEC=604800

# [identity] IdP JWKS URL (external mode) (optional)
AUTH_EXTERNAL_JWKS_URL=

# [identity] Expected iss (external mode) (optional)
AUTH_EXTERNAL_ISSUER=

# [identity] Expected aud values (external mode)
AUTH_EXTERNAL_AUDIENCE=

# [identity] Accepted JWS algorithms (asymmetric only)
AUTH_EXTERNAL_ALGORITHMS=

# [identity] Clock skew tolerance for exp/iat/nbf
AUTH_EXTERNAL_CLOCK_TOLERANCE_SEC=30

# [identity] Claim that marks user tokens (e.g. idtyp) (optional)
AUTH_EXTERNAL_USER_CLAIM=

# [identity] Exact value of the user claim (e.g. user) (optional)
AUTH_EXTERNAL_USER_CLAIM_VALUE=

# [identity] Cookie carrying the IdP token; empty = header only (optional)
AUTH_EXTERNAL_TOKEN_COOKIE=

# [identity] Expected JWT typ header (optional)
AUTH_EXTERNAL_TYP=

# [identity] Reject tokens older than this (iat) (optional)
AUTH_EXTERNAL_MAX_TOKEN_AGE_SEC=

# [identity] Claim granting platform admin (set together with the value) (optional)
AUTH_EXTERNAL_ADMIN_CLAIM=

# [identity] Exact value (or array element) of the admin claim (optional)
AUTH_EXTERNAL_ADMIN_VALUE=

# [identity] JWKS fetch timeout (jose); in external mode RESILIENCE_OVERRIDES["idp-jwks"].timeoutMs must be below it
AUTH_EXTERNAL_JWKS_TIMEOUT_MS=5000

# [identity] Minimum time between JWKS refetches for unknown kids
AUTH_EXTERNAL_JWKS_COOLDOWN_MS=30000

# [identity] JWKS cache max age
AUTH_EXTERNAL_JWKS_CACHE_MAX_AGE_MS=600000

# [identityGuard] Better Auth per-IP rate limit (required in production)
AUTH_RATE_LIMIT_ENABLED=true

# [identityGuard] Default per-IP window for /api/auth/*
AUTH_RATE_LIMIT_WINDOW_SEC=60

# [identityGuard] Default per-IP max requests per window
AUTH_RATE_LIMIT_MAX=100

# [identityGuard] Per-IP window for /sign-in/* and /sign-up/*
AUTH_SIGNIN_RATE_WINDOW_SEC=60

# [identityGuard] Per-IP max for /sign-in/* and /sign-up/*
AUTH_SIGNIN_RATE_MAX=10

# [identityGuard] Per-IP window for /two-factor/*
AUTH_TWO_FACTOR_RATE_WINDOW_SEC=60

# [identityGuard] Per-IP max for /two-factor/*
AUTH_TWO_FACTOR_RATE_MAX=10

# [identityGuard] Per-IP window for password reset and verification emails
AUTH_EMAIL_RATE_WINDOW_SEC=300

# [identityGuard] Per-IP max for password reset and verification emails
AUTH_EMAIL_RATE_MAX=3

# [identityGuard] Failed attempts per account per window before the account is blocked
AUTH_LOCKOUT_MAX_FAILURES=10

# [identityGuard] Fixed window of the account lockout counter
AUTH_LOCKOUT_WINDOW_SEC=900

# [identityGuard] How long a locked account stays blocked
AUTH_LOCKOUT_BLOCK_SEC=900

# [identityGuard] Retry-After on 503 when auth storage is down
AUTH_UNAVAILABLE_RETRY_AFTER_SEC=5

# [identityGuard] At most one "account already exists" email per user per window
AUTH_EXISTING_ACCOUNT_NOTICE_WINDOW_SEC=86400

# [identityGuard] Cron of identity.reconcile-registered
AUTH_REGISTERED_RECONCILE_CRON=*/5 * * * *

# [identityGuard] Timezone of the reconcile cron
AUTH_REGISTERED_RECONCILE_TZ=UTC

# [identityGuard] Users younger than this are left to the after-hook
AUTH_REGISTERED_RECONCILE_GRACE_SEC=120

# [identityGuard] Users per reconcile batch
AUTH_REGISTERED_RECONCILE_BATCH_SIZE=500

# [identityGuard] Max batches per reconcile run
AUTH_REGISTERED_RECONCILE_MAX_BATCHES=20

# [identityGuard] Cron of identity.purge-expired
AUTH_PURGE_CRON=15 3 * * *

# [identityGuard] Timezone of the purge cron
AUTH_PURGE_TZ=UTC

# [identityGuard] Rows deleted per purge statement
AUTH_PURGE_BATCH_SIZE=5000

# [identityGuard] Max purge statements per table per run
AUTH_PURGE_MAX_BATCHES=100

# [authDatabase] Host of the auth_user pool (defaults to DB_HOST) (optional)
DB_AUTH_HOST=

# [authDatabase] Port of the auth_user pool (defaults to DB_PORT) (optional)
DB_AUTH_PORT=

# [authDatabase] Role of the Better Auth pool (schema auth only)
DB_AUTH_USER=auth_user

# [authDatabase] Password of auth_user; required on api/worker unless AUTH_MODE=external (secret) (optional)
DB_AUTH_PASSWORD=

# [authDatabase] Max connections of the auth_user pool per process
DB_AUTH_POOL_MAX=5

# [authDatabase] Max wait for an auth pool connection before answering 503
DB_AUTH_CONNECTION_TIMEOUT_MS=3000
