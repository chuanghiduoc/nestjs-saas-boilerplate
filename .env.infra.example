# Compose infra config (copy to .env.infra). Used only for compose interpolation
# (--env-file .env.infra); never passed into the app containers.

# [devInfra] Postgres superuser (local compose only)
POSTGRES_SUPERUSER=postgres

# [devInfra] Postgres superuser password (local compose only) (required)
POSTGRES_SUPERUSER_PASSWORD=

# [devInfra] statement_timeout set on role app_user
DB_APP_STATEMENT_TIMEOUT_MS=5000

# [devInfra] statement_timeout set on role app_relay
DB_RELAY_STATEMENT_TIMEOUT_MS=60000

# [devInfra] idle_in_transaction_session_timeout for app roles
DB_IDLE_IN_TX_TIMEOUT_MS=10000

# [devInfra] Redis password (compose) (required)
REDIS_PASSWORD=

# [devInfra] Host port for Postgres (bound to 127.0.0.1)
DB_PORT_HOST=5432

# [devInfra] Host port for Redis (bound to 127.0.0.1)
REDIS_PORT_HOST=6379

# [devInfra] Host port for PgBouncer (bound to 127.0.0.1)
PGBOUNCER_PORT_HOST=6432

# [devInfra] Host port for the api container (bound to 127.0.0.1)
HTTP_PORT_HOST=3000

# [devInfra] REDIS_URL used by app containers inside compose, e.g. redis://:<password>@redis:6379; the password must equal REDIS_PASSWORD (required)
COMPOSE_REDIS_URL=

# [devInfra] Host port for the OTel collector OTLP HTTP receiver (bound to 127.0.0.1)
OTEL_PORT_HOST=4318

# [devInfra] statement_timeout set on role auth_user
DB_AUTH_STATEMENT_TIMEOUT_MS=5000

# [devInfra] PgBouncer max_prepared_statements, must be > 0 (RateLimiterPostgres uses named prepared statements through transaction pooling; value from spike S2b)
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# [devInfra] Host port for Mailpit SMTP (bound to 127.0.0.1)
MAILPIT_SMTP_PORT_HOST=1025

# [devInfra] Host port for Mailpit UI/API (bound to 127.0.0.1)
MAILPIT_UI_PORT_HOST=8025
