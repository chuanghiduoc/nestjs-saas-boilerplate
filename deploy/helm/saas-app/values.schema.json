{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "saas-app values (spec SP7 §12.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "environment",
    "config",
    "secretEnv",
    "secretEnvExtra",
    "extraCaCerts",
    "dbCa",
    "otel",
    "serviceAccount",
    "podSecurity",
    "terminationGracePeriodSeconds",
    "tmp",
    "topologySpread",
    "rollout",
    "ports",
    "api",
    "workers",
    "dashboard",
    "migrate",
    "httpRoute",
    "ingress",
    "networkPolicy",
    "connectionBudget"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "tag": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "config": {
      "$ref": "#/$defs/envMap"
    },
    "secretEnv": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/secretEnvName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretName",
          "key"
        ],
        "properties": {
          "secretName": {
            "$ref": "#/$defs/k8sName"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "$ref": "#/$defs/roles"
          }
        }
      }
    },
    "secretEnvExtra": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/envName",
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/secretEnvName"
            },
            {
              "$ref": "#/$defs/chartOwnedEnvName"
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretName",
          "key",
          "roles"
        ],
        "properties": {
          "secretName": {
            "$ref": "#/$defs/k8sName"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "$ref": "#/$defs/roles"
          }
        }
      }
    },
    "extraCaCerts": {
      "$ref": "#/$defs/caRef"
    },
    "dbCa": {
      "$ref": "#/$defs/caRef"
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpoint",
        "endpointFromHostIP",
        "serviceNamePrefix"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "endpointFromHostIP": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "port",
            "scheme"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "$ref": "#/$defs/port"
            },
            "scheme": {
              "enum": [
                "http",
                "https"
              ]
            }
          }
        },
        "serviceNamePrefix": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9-]*)?$"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runAsUser",
        "runAsGroup"
      ],
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "tmp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizeLimit"
      ],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)$"
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "zone"
      ],
      "properties": {
        "hostname": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        },
        "zone": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSurge",
        "revisionHistoryLimit",
        "progressDeadlineSeconds"
      ],
      "properties": {
        "maxSurge": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*%$"
            }
          ]
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "progressDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http",
        "health",
        "dashboard"
      ],
      "properties": {
        "http": {
          "$ref": "#/$defs/port"
        },
        "health": {
          "$ref": "#/$defs/port"
        },
        "dashboard": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "resources",
        "hpa",
        "pdb",
        "service",
        "probes"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "resources": {
          "type": "object"
        },
        "hpa": {
          "$ref": "#/$defs/hpa"
        },
        "pdb": {
          "$ref": "#/$defs/pdb"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "port"
          ],
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "$ref": "#/$defs/port"
            }
          }
        },
        "probes": {
          "$ref": "#/$defs/probes"
        }
      }
    },
    "workers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,20}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workerGroup"
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipAllowlist",
        "ingressFrom"
      ],
      "properties": {
        "ipAllowlist": {
          "type": "string",
          "minLength": 1
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peer"
          }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "args",
        "nameSuffix",
        "activeDeadlineSeconds",
        "timeoutMarginSeconds",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nameSuffix": {
          "type": "string",
          "pattern": "^(-[a-z0-9]([a-z0-9-]*[a-z0-9])?)?$"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMarginSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "parentRefs",
        "hostnames",
        "requestTimeout"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requestTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "parentRefs": {
            "minItems": 1
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "hosts",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "hosts": {
            "minItems": 1
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiIngressFrom",
        "egress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiIngressFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peer"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dns",
            "postgres",
            "pgbouncer",
            "redis",
            "smtp",
            "otel",
            "objectStorage",
            "clamd",
            "idp",
            "internet",
            "extra"
          ],
          "properties": {
            "dns": {
              "$ref": "#/$defs/egressRules"
            },
            "postgres": {
              "$ref": "#/$defs/egressRules"
            },
            "pgbouncer": {
              "$ref": "#/$defs/egressRules"
            },
            "redis": {
              "$ref": "#/$defs/egressRules"
            },
            "smtp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rules",
                "internet"
              ],
              "properties": {
                "rules": {
                  "$ref": "#/$defs/egressRules"
                },
                "internet": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ports",
                    "queues"
                  ],
                  "properties": {
                    "ports": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    },
                    "queues": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    }
                  }
                }
              }
            },
            "otel": {
              "$ref": "#/$defs/egressRules"
            },
            "objectStorage": {
              "$ref": "#/$defs/egressRules"
            },
            "clamd": {
              "$ref": "#/$defs/egressRules"
            },
            "idp": {
              "$ref": "#/$defs/egressRules"
            },
            "internet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "exceptExtra"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "exceptExtra": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$"
                  }
                }
              }
            },
            "extra": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "api",
                "worker",
                "migrate"
              ],
              "properties": {
                "api": {
                  "$ref": "#/$defs/egressRules"
                },
                "worker": {
                  "$ref": "#/$defs/egressRules"
                },
                "migrate": {
                  "$ref": "#/$defs/egressRules"
                }
              }
            }
          }
        }
      }
    },
    "connectionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pgbouncerClients",
        "postgresDirect"
      ],
      "properties": {
        "pgbouncerClients": {
          "type": "integer",
          "minimum": 0
        },
        "postgresDirect": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "httpRoute": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "chartOwnedEnvName": {
      "description": "Env the chart sets per role (spec SP7 §11.3); never in config, api.env or workers.*.env",
      "enum": [
        "APP_ROLE",
        "HTTP_HOST",
        "HTTP_PORT",
        "WORKER_HEALTH_HOST",
        "WORKER_HEALTH_PORT",
        "WORKER_QUEUES",
        "WORKER_QUEUES_EXCLUDE",
        "OUTBOX_AUTOSTART",
        "QUEUE_DASHBOARD_ENABLED",
        "QUEUE_DASHBOARD_HOST",
        "QUEUE_DASHBOARD_PORT",
        "QUEUE_DASHBOARD_IP_ALLOWLIST",
        "OTEL_ENABLED",
        "OTEL_SERVICE_NAME",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_RESOURCE_ATTRIBUTES",
        "DB_SSL_CA_PATH",
        "NODE_EXTRA_CA_CERTS",
        "POD_NAME",
        "POD_NAMESPACE",
        "POD_UID",
        "HOST_IP"
      ]
    },
    "secretOnlyEnvName": {
      "description": "Env that carries credentials but is not a boilerplate config field (OTEL_EXPORTER_OTLP_HEADERS holds collector credentials): only through secretEnvExtra, never in config, api.env or workers.*.env",
      "enum": [
        "OTEL_EXPORTER_OTLP_HEADERS"
      ]
    },
    "secretEnvName": {
      "description": "Generated by pnpm chart:secrets from .meta(secretMeta(...)) on the config schemas; do not edit by hand",
      "enum": [
        "AUTH_GOOGLE_CLIENT_SECRET",
        "AUTH_OIDC_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "DB_APP_PASSWORD",
        "DB_AUTH_PASSWORD",
        "DB_OWNER_PASSWORD",
        "DB_RELAY_PASSWORD",
        "FIELD_ENCRYPTION_KEYS",
        "REDIS_URL",
        "SMTP_PASSWORD"
      ]
    },
    "envMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/envName",
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/secretEnvName"
            },
            {
              "$ref": "#/$defs/chartOwnedEnvName"
            },
            {
              "$ref": "#/$defs/secretOnlyEnvName"
            }
          ]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "api",
          "worker",
          "migrate"
        ]
      }
    },
    "k8sName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
      "maxLength": 253
    },
    "caRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configMapName",
        "key"
      ],
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup",
        "liveness",
        "readiness"
      ],
      "properties": {
        "startup": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "extraMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Resource",
                  "Pods",
                  "External",
                  "Object"
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "minReplicas",
          "maxReplicas",
          "targetCPUUtilizationPercentage",
          "scaleDownStabilizationSeconds",
          "extraMetrics"
        ]
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnavailable"
      ],
      "properties": {
        "maxUnavailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "queueName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "workerGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queues",
        "queuesExclude",
        "relay",
        "dashboard",
        "env",
        "hpa",
        "pdb",
        "resources"
      ],
      "properties": {
        "queues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/queueName"
          }
        },
        "queuesExclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/queueName"
          }
        },
        "relay": {
          "type": "boolean"
        },
        "dashboard": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "$ref": "#/$defs/envMap"
        },
        "hpa": {
          "$ref": "#/$defs/hpa"
        },
        "pdb": {
          "$ref": "#/$defs/pdb"
        },
        "resources": {
          "type": "object"
        },
        "probes": {
          "$ref": "#/$defs/probes"
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": {
          "type": "object"
        },
        "namespaceSelector": {
          "type": "object"
        },
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "egressRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "ports"
        ],
        "properties": {
          "to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/peer"
            }
          },
          "ports": {
