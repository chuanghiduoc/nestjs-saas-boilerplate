{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "secretEnvName": {
      "description": "Generated by pnpm chart:secrets from .meta(secretMeta(...)) on the config schemas; do not edit by hand",
      "enum": [
        "AUTH_GOOGLE_CLIENT_SECRET",
        "AUTH_OIDC_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "DB_APP_PASSWORD",
        "DB_AUTH_PASSWORD",
        "DB_OWNER_PASSWORD",
        "DB_RELAY_PASSWORD",
        "FIELD_ENCRYPTION_KEYS",
        "REDIS_URL",
        "SMTP_PASSWORD"
      ]
    }
  }
}
